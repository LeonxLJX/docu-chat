# === App ===
NODE_ENV=production
PORT=3000

# === Admin auth (first-run setup) ===
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# === Database ===
# SQLite file path. On Railway, this should be a mounted volume path.
DB_PATH=./data/docuchat.db

# === License ===
# Leave blank in dev. In prod, your Lemon Squeezy API key (server-side only).
LEMON_SQUEEZY_API_KEY=
# The product / variant id you created in Lemon Squeezy (optional).
LEMON_SQUEEZY_PRODUCT_ID=
